# PostgreSQL (Docker internal = 5432, Local host = 5434)
POSTGRES_DB=duoquiz
POSTGRES_USER=duoquiz
POSTGRES_PASSWORD=duoquiz_secret
POSTGRES_HOST_PORT=5434
POSTGRES_CONTAINER_PORT=5432
DATABASE_URL=postgresql://duoquiz:duoquiz_secret@postgres:5432/duoquiz?schema=public

# Redis
REDIS_HOST_PORT=6379
REDIS_URL=redis://redis:6379

# MinIO (S3-compatible Object Storage)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_DEFAULT_REGION=us-east-1
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=http://10.0.2.2:9000
S3_BUCKET=duoquiz-media
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# Backend API & Worker
BACKEND_PORT=4000
PORT=4000
NODE_ENV=development
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars_dev
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars_dev
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
GOOGLE_CLIENT_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@duoquiz.app

# LLM
GEMINI_API_KEY=
OPENAI_API_KEY=
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash-lite
LLM_FALLBACK_MODEL=gemini-2.5-flash
LLM_PROMPT_VERSION=quiz-v1

# Docling Sidecar
DOCLING_PORT=8001
DOCLING_SERVICE_URL=http://docling-service:8001
